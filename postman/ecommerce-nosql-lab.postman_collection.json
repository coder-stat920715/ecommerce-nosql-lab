    {
      "name": "5. Tenant-based application partitioning",
      "description": "",
      "item": [
        {
          "name": "Save order in tenant DATABASE (X-Tenant-Id: acme)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "acme"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tenants/orders"
            },
            "body": {
              "mode": "raw",
